# 로컬에서 테스트할 때만 사용합니다 (Render에서는 대시보드의 Environment 탭에 직접 넣습니다).
# 이 파일을 복사해 .env 로 저장하고 값을 채우세요. .env는 git에 올라가지 않습니다.

TZ=America/Toronto
NODE_ENV=development
PORT=3000

# 이 서버가 실제로 떠 있는 주소 (구글 로그인 redirect_uri 를 여기 기준으로 만듭니다)
BASE_URL=http://localhost:3000

# 쿠키 서명용 임의의 긴 문자열 (아무 값이나 — openssl rand -hex 32 등으로 생성)
SESSION_SECRET=change-this-to-a-long-random-string

# 구글 드라이브 폴더 ID — 이 폴더 안에 DB 시트와 파일(악보·음원·사진)을 저장합니다
DB_FOLDER_ID=1jmsI1cWJIgWSafcbXXXVp3CLu3KI_PEE

# --- ① 서버가 구글 시트·드라이브에 접근할 때 쓰는 자격 (Desktop app 유형 OAuth 클라이언트) ---
# npm run auth 로 한 번 발급받아 GOOGLE_REFRESH_TOKEN 을 채웁니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- ② 멤버가 "Google로 로그인" 할 때 쓰는 자격 (Web application 유형 OAuth 클라이언트) ---
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
