# 로컬에서 테스트할 때만 사용합니다 (Render에서는 대시보드의 Environment 탭에 직접 넣습니다).
# 이 파일을 복사해 .env 로 저장하고 값을 채우세요. .env는 git에 올라가지 않습니다.

TZ=America/Toronto
NODE_ENV=development
PORT=3000

# 이 서버가 실제로 떠 있는 주소 (구글 로그인 redirect_uri 를 여기 기준으로 만듭니다)
BASE_URL=http://localhost:3000

# 쿠키 서명용 임의의 긴 문자열 (아무 값이나 — openssl rand -hex 32 등으로 생성)
SESSION_SECRET=change-this-to-a-long-random-string

# 구글 드라이브 폴더 ID — 이 폴더 안에 DB 시트와 파일(악보·음원·사진)을 저장합니다
DB_FOLDER_ID=1jmsI1cWJIgWSafcbXXXVp3CLu3KI_PEE

# --- ① 서버가 구글 시트·드라이브에 접근할 때 쓰는 자격 (Desktop app 유형 OAuth 클라이언트) ---
# npm run auth 로 한 번 발급받아 GOOGLE_REFRESH_TOKEN 을 채웁니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- ② 멤버가 "Google로 로그인" 할 때 쓰는 자격 (Web application 유형 OAuth 클라이언트) ---
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# --- 악보 보관함 — Cloudflare R2 (이 앱 전용 새 버킷). 앞의 4개가 다 있어야 켜집니다 (없으면 예전처럼 구글 드라이브) ---
# 새로 올리는 악보는 R2 에 저장되고, R2 에 옮겨 둔 예전 악보(scripts/migrate-sheets-to-r2.js)는 R2 에서 읽습니다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 1 이면 브라우저가 악보를 R2 에서 바로 받음 (Render 대역폭 절약). 먼저 node --env-file=.env scripts/r2-setup.js 로 CORS 설정
# R2_DIRECT=1
# R2 에 올릴 폴더 (기본 '악보,악보원본,나만 보는 악보')
# R2_FOLDERS=

# --- ③ 드라이브 메뉴 — 미디어팀 NAS(Synology) ---
# 비밀번호는 여기(.env)나 Render 환경변수에만 넣고 코드에는 넣지 않습니다.
NAS_PASSWORD=
# NAS_USER=praise3
# NAS_QUICKCONNECT_ID=youngnakmedia
# QuickConnect 로 연결이 안 되면 NAS 외부 주소를 직접: (예) https://youngnakmedia.synology.me:5001
# NAS_URL=
# 이 폴더 아래만 보이게 — 넣지 않으면 /praise3/Captures (빈 값 NAS_ROOT= 이면 모든 공유 폴더)
# NAS_ROOT=/praise3/Captures
# 자체 서명 인증서 · IP 주소로 접속할 때만 1
# NAS_INSECURE_TLS=

# 녹음 카드의 "NAS 열기" 링크 주소 (기본: https://<NAS_QUICKCONNECT_ID>.quickconnect.to · 빈 값이면 링크 숨김)
# NAS_OPEN_URL=
# 녹음 카드의 "NAS 열기" 아래에 보이는 로그인 안내 글 (객원 제외 팀원에게만). 비밀번호는 여기 · Render 환경변수에만 넣고 저장소에는 쓰지 마세요
# NAS_LOGIN_HINT=
